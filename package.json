{
  "name": "js-browser",
  "version": "1.0.0",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jscodeshift": "0.7.2",
    "@types/node": "^24.19.2",
    "@types/prettier": "^2.7.2",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@types/react-resizable": "3.0.2",
    "@types/streamsaver": "^2.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^5.15.1",
    "@monaco-editor/react": "3.7.5",
    "@uiw/react-md-editor": "2.1.1",
    "assert": "^2.1.0",
    "axios": "^1.3.2",
    "bulmaswatch": "^0.8.1",
    "esbuild-wasm": "0.28.2",
    "immer": "^9.0.19",
    "jscodeshift": "0.11.0",
    "localforage": "^1.10.0",
    "lodash": "^4.18.1",
    "monaco-editor": "^0.34.1",
    "monaco-jsx-highlighter": "0.0.15",
    "prettier": "^2.8.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "8.0.5",
    "react-resizable": "3.0.4",
    "redux": "4.2.1",
    "redux-thunk": "2.3.0",
    "streamsaver": "^2.0.6",
    "typescript": "^5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@monaco-editor/react": {
      "monaco-editor": "$monaco-editor",
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "monaco-jsx-highlighter": {
      "monaco-editor": "$monaco-editor"
    }
  }
}
